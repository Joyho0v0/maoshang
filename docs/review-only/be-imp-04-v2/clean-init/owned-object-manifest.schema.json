{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review.invalid/joyho-33/clean-init/owned-object-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "objects"],
  "properties": {
    "version": { "const": 1 },
    "projectId": { "const": "JOYHO-33" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "table", "organizationColumn", "requiredAtPreflight"],
        "properties": {
          "schema": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "organizationColumn": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" },
          "requiredAtPreflight": { "type": "boolean" }
        }
      }
    }
  }
}
