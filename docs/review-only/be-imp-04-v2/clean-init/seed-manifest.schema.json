{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review.invalid/joyho-33/clean-init/seed-manifest.schema.json",
  "title": "JOYHO-33 synthetic clean-init seed manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "projectId", "environmentClass", "synthetic", "seedId", "organizations", "products", "skus", "orders"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "projectId": { "const": "JOYHO-33" },
    "environmentClass": { "const": "disposable-local" },
    "synthetic": { "const": true },
    "seedId": { "type": "string", "pattern": "^seed-[a-z0-9-]+$" },
    "organizations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/organization" } },
    "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/product" } },
    "skus": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sku" } },
    "orders": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/order" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "datetime": { "type": "string", "format": "date-time" },
    "amount": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,14})(?:\\.[0-9]{1,4})?$" },
    "quantity": { "type": "string", "pattern": "^(?:[1-9][0-9]{0,11}(?:\\.[0-9]{1,6})?|0\\.(?=[0-9]{1,6}$)0*[1-9][0-9]*)$" },
    "organization": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "name"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "code": { "type": "string", "pattern": "^SYN-[A-Z0-9-]+$" }, "name": { "type": "string", "pattern": "^Synthetic Organization [0-9]+$" } }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "organizationId", "productCode", "name", "unit", "status"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "organizationId": { "$ref": "#/$defs/uuid" }, "productCode": { "type": "string", "pattern": "^SYN-PROD-[A-Z0-9-]+$" }, "name": { "type": "string", "pattern": "^Synthetic Product [0-9]+$" }, "unit": { "type": "string", "minLength": 1, "maxLength": 32 }, "status": { "const": "ACTIVE" } }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "currency", "unitPrice", "validFrom", "validTo", "version", "isPrimary", "riskBufferBps", "lifecycle"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "currency": { "$ref": "#/$defs/currency" }, "unitPrice": { "$ref": "#/$defs/amount" }, "validFrom": { "$ref": "#/$defs/datetime" }, "validTo": { "anyOf": [{ "$ref": "#/$defs/datetime" }, { "type": "null" }] }, "version": { "type": "integer", "minimum": 1 }, "isPrimary": { "const": true }, "riskBufferBps": { "type": "integer", "minimum": 0, "maximum": 2000 }, "lifecycle": { "const": "ACTIVE" } }
    },
    "sku": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "organizationId", "productId", "skuCode", "name", "unit", "baseUnit", "trackingMode", "standardizationMode", "status", "orderable", "policies"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "organizationId": { "$ref": "#/$defs/uuid" }, "productId": { "$ref": "#/$defs/uuid" }, "skuCode": { "type": "string", "pattern": "^SYN-SKU-[A-Z0-9-]+$" }, "name": { "type": "string", "pattern": "^Synthetic SKU [0-9]+$" }, "unit": { "type": "string", "minLength": 1, "maxLength": 32 }, "baseUnit": { "type": "string", "minLength": 1, "maxLength": 32 }, "trackingMode": { "enum": ["NONE", "LOT", "SERIAL"] }, "standardizationMode": { "enum": ["STRICT", "SIMPLE", "NONE"] }, "status": { "const": "ACTIVE" }, "orderable": { "const": true }, "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policy" } } }
    },
    "priceSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceKind", "sourceCurrency", "sourceUnitPrice", "sourcePolicyId", "capturedAt"],
      "properties": { "sourceKind": { "const": "CATALOG_POLICY" }, "sourceCurrency": { "$ref": "#/$defs/currency" }, "sourceUnitPrice": { "$ref": "#/$defs/amount" }, "sourcePolicyId": { "$ref": "#/$defs/uuid" }, "capturedAt": { "$ref": "#/$defs/datetime" } }
    },
    "line": {
      "type": "object", "additionalProperties": false,
      "required": ["lineId", "itemKind", "skuId", "name", "unit", "quantity", "effectiveUnitPrice", "lineAmount", "currency", "standardizationMode", "priceSnapshot", "fxSnapshot"],
      "properties": { "lineId": { "$ref": "#/$defs/uuid" }, "itemKind": { "const": "STANDARD" }, "skuId": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1 }, "unit": { "type": "string", "minLength": 1 }, "quantity": { "$ref": "#/$defs/quantity" }, "effectiveUnitPrice": { "$ref": "#/$defs/amount" }, "lineAmount": { "$ref": "#/$defs/amount" }, "currency": { "$ref": "#/$defs/currency" }, "standardizationMode": { "enum": ["STRICT", "SIMPLE", "NONE"] }, "priceSnapshot": { "$ref": "#/$defs/priceSnapshot" }, "fxSnapshot": { "type": "null" } }
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "organizationId", "orderNo", "currency", "lines"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "organizationId": { "$ref": "#/$defs/uuid" }, "orderNo": { "type": "string", "pattern": "^SYN-ORDER-[A-Z0-9-]+$" }, "currency": { "$ref": "#/$defs/currency" }, "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } } }
    }
  }
}
