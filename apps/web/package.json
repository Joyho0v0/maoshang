{
  "name": "@autoflow/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run src/core",
    "test:smoke": "vitest run src/ui src/router.test.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.105.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.3.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-tsc": "2.2.0"
  }
